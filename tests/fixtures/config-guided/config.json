{
  "version": 2,
  "base_branch": "main",
  "concurrency": 3,
  "max_rounds": 3,
  "default": {
    "runner": "codex",
    "model": "fixture-default",
    "reasoning": "fixture-reasoning",
    "executable": "fixture-codex",
    "timeout_seconds": 1800,
    "extension": {"nested": {"keep": ["one"]}}
  },
  "roles": {
    "builder": {
      "runner": "claude",
      "model": "fixture-builder",
      "reasoning": "fixture-builder-reasoning",
      "executable": "fixture-claude",
      "timeout_seconds": 900
    },
    "review-code": {"model": null},
    "review-ui": {"timeout_seconds": 600}
  },
  "skills": {"roots": ["fixture skills"], "include": [], "exclude": ["fixture-excluded"]},
  "extension": {"keep": ["single"], "nested": {"empty": [], "flag": true}}
}
